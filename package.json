{
  "name": "poker-workspace",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm -r build",
    "build:types": "pnpm --filter poker-types build",
    "build:client": "pnpm --filter poker-client build",
    "build:server": "pnpm --filter poker-server build",
    "build:registry": "pnpm --filter poker-registry build:registry",
    "dev:client": "pnpm --dir poker-client run dev",
    "dev:server": "pnpm --dir poker-server run start:dev",
    "test:bootstrap": "bash ./scripts/test-bootstrap-worktree.sh",
    "test:server:unit": "pnpm --filter poker-server test:unit -- --runInBand",
    "test:e2e:smoke": "pnpm --filter poker-server test:e2e:playwright:smoke"
  }
}
