# Repository-wide environment template.
# Copy this file to `.env` at the repo root for local development.
#
# Package behavior:
# - `poker-server` loads the repo-root `.env`
# - `poker-client` loads Vite env vars from the repo root
# - `poker-registry` loads the repo-root `.env`
# - Docker Compose reads the repo-root `.env` automatically

###############################################################################
# Docker compose
###############################################################################

# Host port mapped to the production container's internal port 3000.
HOST_PORT=3000

# Docker volume name used for persistent server data.
POKER_DATA_VOLUME=poker_data

###############################################################################
# Shared runtime toggles
###############################################################################

# Typical values: development, test, production
NODE_ENV=development

# Enables stricter CI behavior in Playwright config when truthy.
CI=

# Server test mode toggle used by gameplay/e2e paths.
TEST_MODE=false

###############################################################################
# poker-server core runtime
###############################################################################

PORT=3001
HOST=0.0.0.0

# Comma-separated origins or *.
CORS_ORIGIN=http://localhost:5173

# Preferred client origin used for room-share URLs.
CLIENT_URL=http://localhost:5173
CLIENT_PROTOCOL=http
CLIENT_PORT=5173

# Canonical Postgres connection string for backend persistence.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/poker
PG_MAX_CONNECTIONS=10
DATABASE_MIGRATE_ON_BOOT=true
# Safety valve for `pnpm --dir poker-server run db:backfill`.
# Leave unset unless you intentionally want to replace existing Postgres data.
DB_BACKFILL_OVERWRITE=

# Server file data directory. Relative paths resolve from `poker-server/`.
# After the Postgres migration, this remains for uploaded chat audio only.
DATA_DIR=./data

# Optional explicit built frontend path served by the backend.
# Relative paths resolve from `poker-server/`.
FRONTEND_DIST_PATH=../poker-client/dist

###############################################################################
# poker-server authentication / WebAuthn / cookies
###############################################################################

# Can be a host:port or full origin. Used to derive WebAuthn defaults when
# WEBAUTHN_* are not set.
AUTH_DOMAIN=localhost:5173

# Explicit WebAuthn relying party config. WEBAUTHN_ORIGIN can be comma-separated.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=Poker Game

# Password login is enabled automatically outside production. Set true to force
# enablement in production.
AUTH_PASSWORD_LOGIN_ENABLED=true

# Pending flow cleanup / rate limiting.
AUTH_FLOW_CLEANUP_INTERVAL_MS=60000
AUTH_MAX_PENDING_FLOWS=1000
AUTH_RATE_LIMIT_MAX_WINDOWS=5000
AUTH_PASSKEY_REGISTER_START_RATE_LIMIT_COUNT=20
AUTH_PASSKEY_REGISTER_START_RATE_LIMIT_WINDOW_MS=600000
AUTH_PASSKEY_LOGIN_START_RATE_LIMIT_COUNT=30
AUTH_PASSKEY_LOGIN_START_RATE_LIMIT_WINDOW_MS=600000
AUTH_PASSWORD_LOGIN_RATE_LIMIT_COUNT=10
AUTH_PASSWORD_LOGIN_RATE_LIMIT_WINDOW_MS=600000

# Session cookie options.
AUTH_SESSION_COOKIE_NAME=poker_session
AUTH_COOKIE_DOMAIN=
# Allowed values: lax, strict, none
AUTH_COOKIE_SAME_SITE=lax
# Leave blank for auto-detection from request/origin. Set true/false to force.
AUTH_COOKIE_SECURE=

###############################################################################
# poker-server gameplay / chat tuning
###############################################################################

RUN_COUNT_DECISION_WINDOW_MS=15000
CHAT_DEDUPE_WINDOW_MS=600000
CHAT_MAX_DEDUPE_CACHE_SIZE=50000
CHAT_RATE_LIMIT_COUNT=5
CHAT_RATE_LIMIT_WINDOW_MS=10000
CHAT_TEXT_MAX_LENGTH=300
CHAT_VOICE_MAX_DURATION_MS=60000
CHAT_VOICE_MAX_BYTES=2097152
CHAT_PAGE_SIZE=50
CHAT_PAGE_MAX_SIZE=200
CHAT_MAX_MESSAGES=200

###############################################################################
# poker-server AI robot provider
###############################################################################

# OpenAI-compatible provider settings.
AI_ROBOT_API_KEY=
# Example: https://api.openai.com/v1
AI_ROBOT_BASE_URL=
AI_ROBOT_MODEL_ID=
# Allowed values in current code: chat, responses
AI_ROBOT_API_MODE=chat
AI_ROBOT_TEMPERATURE=0.3
AI_ROBOT_MAX_AGENT_STEPS=6
AI_ROBOT_TOOL_RETRY_LIMIT=4
AI_ROBOT_ACTION_DELAY_MIN_MS=1000
AI_ROBOT_ACTION_DELAY_MAX_MS=2500

###############################################################################
# poker-server LiveKit live audio
###############################################################################

LIVE_AUDIO_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_AUDIO_TOKEN_TTL=10m

###############################################################################
# poker-client Vite socket target
###############################################################################

# Full backend URL. If set, it takes precedence over protocol/host/port.
VITE_SERVER_URL=http://localhost:3001
VITE_SERVER_PROTOCOL=http
VITE_SERVER_HOST=localhost
VITE_SERVER_PORT=3001

###############################################################################
# poker-server Playwright / e2e targeting
###############################################################################

# Preferred public vars from AGENTS.md.
PW_FRONTEND_URL=
PW_BACKEND_URL=
PW_FRONTEND_HOST=localhost
PW_FRONTEND_PORT=5174
PW_BACKEND_HOST=localhost
PW_BACKEND_PORT=3001
PW_FRONTEND_BIND_HOST=localhost

# Optional Playwright project toggles.
PW_INCLUDE_DEBUG_PROJECT=false
PW_LIVE_ROBOT_E2E=0

# Used by the parallel comprehensive Playwright npm script.
PW_WORKERS=3
PG_TEST_PORT=55432

# Backward-compatible aliases also consumed by playwright.config.ts.
E2E_FRONTEND_URL=
E2E_BACKEND_URL=
E2E_FRONTEND_PORT=
E2E_BACKEND_PORT=
E2E_FRONTEND_BIND_HOST=

###############################################################################
# poker-client Storybook helper script
###############################################################################

# storybook-dev-fast defaults this to 1 when unset.
STORYBOOK_FAST_MODE=1

# Set to 0 to disable prewarming in storybook-dev-fast.
STORYBOOK_PREWARM=1

###############################################################################
# poker-registry
###############################################################################

REGISTRY_PORT=3022
REGISTRY_HOST=0.0.0.0
