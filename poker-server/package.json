{
  "name": "poker-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --dir .. --filter poker-types build && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=test/e2e/",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register ./node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:playwright": "npm_config_proxy= npm_config_https_proxy= HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY='*' TEST_MODE=true ./node_modules/.bin/playwright test",
    "test:e2e:playwright:smoke": "npm_config_proxy= npm_config_https_proxy= HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY='*' TEST_MODE=true ./node_modules/.bin/playwright test --project comprehensive-e2e --workers=1 --grep @critical --reporter=line",
    "test:e2e:playwright:comprehensive": "npm_config_proxy= npm_config_https_proxy= HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY='*' TEST_MODE=true ./node_modules/.bin/playwright test --project comprehensive-e2e --reporter=line",
    "test:e2e:playwright:comprehensive:parallel": "npm_config_proxy= npm_config_https_proxy= HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY='*' TEST_MODE=true PW_WORKERS=${PW_WORKERS:-3} ./node_modules/.bin/playwright test --project comprehensive-e2e --reporter=line",
    "test:e2e:playwright:live-robot": "npm_config_proxy= npm_config_https_proxy= HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY='*' TEST_MODE=true PW_LIVE_ROBOT_E2E=1 ./node_modules/.bin/playwright test --project live-robot-e2e --workers=1 --reporter=line",
    "test:e2e:ui": "npm_config_proxy= npm_config_https_proxy= HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY='*' TEST_MODE=true ./node_modules/.bin/playwright test --ui",
    "test:unit": "jest test/unit src",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:backfill": "node -r ts-node/register ./scripts/backfill-json-to-db.ts",
    "db:backfill:force": "DB_BACKFILL_OVERWRITE=true node -r ts-node/register ./scripts/backfill-json-to-db.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.102",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@simplewebauthn/server": "^13.2.2",
    "ai": "^6.0.116",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.1",
    "livekit-server-sdk": "^2.15.1",
    "multer": "^2.0.2",
    "nanoid": "^3.3.11",
    "pg": "^8.20.0",
    "poker-types": "workspace:*",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@playwright/test": "^1.58.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "pm2": "^6.0.14",
    "prettier": "^3.0.0",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^poker-types$": "<rootDir>/../poker-types/src"
    }
  }
}
